# 构建产物
/dist/
/polycode-hub
*.exe
*.test
*.out

# 前端构建产物不入库（Java 的 target/ 口径：要用就自己打包）。
# 网关运行时现读 web/dist 挂载 /admin，所以 clone 后必须先 `npm run setup`
# （含 build）或 `npm run build --prefix web` 才能打开控制台，否则 /admin 全 404。
# 文件名带内容 hash，入库会导致每次前端改动都在历史里留下一次完整产物的增删。
/web/dist/

# 本地配置（含密钥，勿提交）
/config/apps.yaml
/config/credentials/*
!/config/credentials/.gitkeep
/config/credentials/*.pem
/data/

# ZCode sidecar 运行产物（二进制 63MB + 含 proxyApiKey 的 config + 日志）
/config/zcode-proxy/
# launchd 部署样板：只入库 .example（占位路径），真实 plist 含本机用户名与绝对路径，不入库
/config/*.launchd.plist
!/config/*.launchd.plist.example

# 敏感凭据类文件（任何形态都不入库）
*.key
*.pem
*.p12
*.pfx
.env
.env.*
!.env.example

# sidecar 构建产物（若在本仓构建上游工具）
zcode-proxy
zcode-proxy-*

# Go
/vendor/
go.work
go.work.sum

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 日志
*.log

# 远端只留 README：docs/ 与根目录文档已下架，备份在这里仅供本地查阅。
# 历史已用 filter-branch 重写，这些文件在远端不再可见。
.local-docs/

# Agent 记忆（非项目交付物）
.workbuddy/
.worktrees/
# superpowers 运行产物（sdd 任务痕迹、临时 diff）。
# 它自带 sdd/.gitignore 写了 *，但那是外部工具的自我约束——
# 显式声明一次，避免换版本/改结构后误把过程文件提进来。
# 注意：只忽略运行产物，skills/superpowers/（技能本身）是入库的。
.superpowers/
/web/node_modules/

# docs/ 分两类：对外文档入库，私人/生成物不入库。
# 原标题是「远端只留 README：docs/ 整体下架」，但那样会把 README 里引用的架构图
# 一起挡掉（README 有 ![架构图](docs/architecture.png)，公开后是死链）。
# 改为按文件粒度控制：下面白名单放行对外资源，其余仍被 /docs/ 挡住。
/docs/*
!/docs/FEATURES.md
!/docs/architecture.png
!/docs/architecture.svg
!/docs/polycode-hub.architecture.json
# 仍然不入库（含本机绝对路径 /Users/... 与私人工作安排）：
#   docs/HANDOFF-NEXT.md             交棒笔记
#   docs/architecture.html           718K 可交互版，体积大
#   docs/architecture.visual-check.json  构建工具校验产物

# Agent 本地规划状态（非项目交付物）
.zcode/

# 项目板块运行时状态
/config/projects/

# Node
node_modules/
*.tgz

# 测试运行数据（零配置起服的临时数据目录）
/data-zero/

# 远端只留 README：skills/ 一并下架（此前按"项目交付物"入库，现已改口径）。
# 文件保留在本机 .local-docs/skills/ 备份，此处目录仅本地可用、永不入库。
/skills/

# 本机登录态/凭据备份（时间戳目录，绝不入库——内容是引擎与客户端的凭据本体）
.cred-backup*/

# AI 会话临时脚本（上一轮会话留下的测速/对比草稿，非项目交付物）
/.cmp*.mjs
